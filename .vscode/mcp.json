{
  "inputs": [
    {
      "type": "promptString",
      "id": "notion_token",
      "description": "Token de Notion compartido en el taller (te lo da quien presenta)",
      "password": true
    }
  ],
  "servers": {
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${input:notion_token}"
      }
    }
  }
}
